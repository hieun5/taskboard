# Copy to .env.local for local development.

# Postgres connection string (Azure: Azure Database for PostgreSQL Flexible Server, add ?sslmode=require)
DATABASE_URL=postgres://taskboard:taskboard@localhost:5432/taskboard

# Public URL of the site (used in sign-in emails). Use https:// in production.
APP_URL=http://localhost:3000

# Random string, at least 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Comma-separated emails that can always sign in and are admins (you).
ADMIN_EMAILS=you@example.com

# Email: "console" writes emails to .data/dev-outbox.json and shows them at /dev/mail (local only).
#        "azure" sends through Azure Communication Services Email.
MAIL_DRIVER=console
# MAIL_FROM=DoNotReply@xxxxxxxx.azurecomm.net
# ACS_CONNECTION_STRING=endpoint=https://....communication.azure.com/;accesskey=...

# File storage: "local" keeps files in .data/uploads, "azure" uses Azure Blob Storage.
STORAGE_DRIVER=local
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_KEY=
# AZURE_STORAGE_CONTAINER=attachments
MAX_UPLOAD_MB=25
